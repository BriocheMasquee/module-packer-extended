{
  "name": "mpx-core",
  "version": "0.26.3",
  "private": true,
  "description": "Standalone compiler engine: turns Markdown/YAML module projects into EncounterPlus V5 .module files. No VSCode dependency.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "test": "npm run compile && node --test test/*.test.js"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "markdown-it": "^15.0.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-attrs": "^5.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-multimd-table": "^4.2.3",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-underline": "^1.0.1",
    "unzipper": "^0.12.3",
    "yaml": "^2.9.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/unzipper": "^0.10.11",
    "@types/yazl": "^3.3.1"
  }
}
