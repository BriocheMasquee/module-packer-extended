{
  "name": "mpx",
  "displayName": "Module Packer Extended",
  "description": "Build EncounterPlus V5 modules from Markdown projects.",
  "version": "0.7.0",
  "publisher": "local",
  "license": "CC0-1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/BriocheMasquee/mpx-bis.git"
  },
  "icon": "mpx-icon-128.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "EncounterPlus",
    "Markdown",
    "module",
    "packer"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "Module Packer Extended",
      "properties": {
        "mpx.autoIncrementVersion": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "Whether to automatically bump `module.json`'s patch version (e.g. `1.0.0` -> `1.0.1`) after each successful build.\n\nPossible values: `true` (default) or `false`."
        }
      }
    },
    "commands": [
      {
        "command": "mpx.createModuleProject",
        "title": "Create Module Project",
        "category": "MPX",
        "icon": "$(new-folder)"
      },
      {
        "command": "mpx.refreshExplorer",
        "title": "Refresh Module Explorer",
        "category": "MPX",
        "icon": "$(refresh)"
      },
      {
        "command": "mpx.createPage",
        "title": "Create Page",
        "category": "MPX",
        "icon": "$(new-file)"
      },
      {
        "command": "mpx.createGroup",
        "title": "Create Group",
        "category": "MPX",
        "icon": "$(new-folder)"
      },
      {
        "command": "mpx.createMapReference",
        "title": "Create Map Reference",
        "category": "MPX",
        "icon": "$(map)"
      },
      {
        "command": "mpx.createEncounterReference",
        "title": "Create Encounter Reference",
        "category": "MPX",
        "icon": "$(target)"
      },
      {
        "command": "mpx.buildModule",
        "title": "Build Module",
        "category": "MPX",
        "icon": "$(package)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mpx",
          "title": "Module Packer Extended",
          "icon": "resources/mpx-icon-mono.svg"
        }
      ]
    },
    "views": {
      "mpx": [
        {
          "id": "mpx.projectExplorer",
          "name": "Project",
          "icon": "resources/mpx-icon-mono.svg"
        },
        {
          "id": "mpx.moduleExplorer",
          "name": "Module",
          "icon": "resources/mpx-icon-mono.svg"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": "/module.json",
        "url": "./resources/schemas/module.schema.json"
      }
    ],
    "viewsWelcome": [
      {
        "view": "mpx.projectExplorer",
        "contents": "Welcome to Module Packer Extended.\n[Create Module Project](command:mpx.createModuleProject)",
        "when": "mpx.workspaceKind == empty || mpx.workspaceKind == noFolder"
      },
      {
        "view": "mpx.projectExplorer",
        "contents": "This folder is neither empty nor a recognized MPX project.",
        "when": "mpx.workspaceKind == unsupported"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "mpx.createPage",
          "when": "view == mpx.moduleExplorer",
          "group": "navigation@1"
        },
        {
          "command": "mpx.createGroup",
          "when": "view == mpx.moduleExplorer",
          "group": "navigation@2"
        },
        {
          "command": "mpx.createMapReference",
          "when": "view == mpx.moduleExplorer",
          "group": "navigation@3"
        },
        {
          "command": "mpx.createEncounterReference",
          "when": "view == mpx.moduleExplorer",
          "group": "navigation@4"
        },
        {
          "command": "mpx.refreshExplorer",
          "when": "view == mpx.moduleExplorer",
          "group": "navigation@5"
        },
        {
          "command": "mpx.buildModule",
          "when": "view == mpx.projectExplorer",
          "group": "navigation@1"
        }
      ]
    }
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"no tests yet\""
  },
  "dependencies": {
    "mpx-core": "*"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.3"
  }
}
