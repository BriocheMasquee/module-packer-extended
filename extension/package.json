{
  "name": "mpx",
  "displayName": "Module Packer Extended",
  "description": "Build EncounterPlus V5 modules from Markdown projects.",
  "version": "0.1.0",
  "publisher": "local",
  "license": "CC0-1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/BriocheMasquee/mpx-bis.git"
  },
  "icon": "mpx-icon-128.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "EncounterPlus",
    "Markdown",
    "module",
    "packer"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "mpx.createModuleProject",
        "title": "Create Module Project",
        "category": "MPX",
        "icon": "$(new-folder)"
      },
      {
        "command": "mpx.refreshExplorer",
        "title": "Refresh Module Explorer",
        "category": "MPX",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mpx",
          "title": "Module Packer Extended",
          "icon": "resources/mpx-icon-mono.svg"
        }
      ]
    },
    "views": {
      "mpx": [
        {
          "id": "mpx.moduleExplorer",
          "name": "Module",
          "icon": "resources/mpx-icon-mono.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "mpx.moduleExplorer",
        "contents": "Welcome to Module Packer Extended.\n[Create Module Project](command:mpx.createModuleProject)",
        "when": "mpx.workspaceKind == empty || mpx.workspaceKind == noFolder"
      },
      {
        "view": "mpx.moduleExplorer",
        "contents": "This folder is neither empty nor a recognized MPX project.",
        "when": "mpx.workspaceKind == unsupported"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "mpx.refreshExplorer",
          "when": "view == mpx.moduleExplorer",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"no tests yet\""
  },
  "dependencies": {
    "mpx-core": "*"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.3"
  }
}
