{
  "MPX Spell Block": {
    "prefix": "mpx-spell",
    "body": [
      "```spell",
      "name: \"${1:New Spell}\"",
      "slug: ${2:new-spell}",
      "attributes:",
      "  measurement: \"\"",
      "  ruleset: \"5.5e\"",
      "image: \"spells/\"",
      "showImage: true",
      "level: ${3:0}",
      "school: \"${4:}\"",
      "showSchoolIcon: true",
      "ritual: ${5:false}",
      "activation:",
      "  time: ${6:0}",
      "  unit: \"${7:}\"",
      "  condition: \"\"",
      "rangeType: \"${8:}\"",
      "range: ${9:0}",
      "areaEffectShape: \"\"",
      "areaEffectSize: 0",
      "showAreaEffectIcon: true",
      "components: []",
      "componentsDetail: \"\"",
      "durationType: \"${10:}\"",
      "duration: ${11:0}",
      "durationUnit: \"${12:}\"",
      "classes: []",
      "descr: \"${13:}\"",
      "sources:",
      "  - name: \"\"",
      "    page: 0",
      "showSources: true",
      "tags: []",
      "showTags: true",
      "```",
      "$0"
    ],
    "description": "Insert a complete MPX inline spell block (all fields, with sensible empty defaults)"
  },
  "MPX Item Block": {
    "prefix": "mpx-item",
    "body": [
      "```item",
      "name: \"${1:New Item}\"",
      "slug: ${2:new-item}",
      "attributes:",
      "  measurement: \"\"",
      "  ruleset: \"5.5e\"",
      "image: \"items/\"",
      "showImage: true",
      "type: \"${3:}\"",
      "typeDetail: \"\"",
      "rarity: \"${4:}\"",
      "attunement: ${5:false}",
      "attunementDetail: \"\"",
      "value: ${6:0}",
      "weight: ${7:0}",
      "ac: 0",
      "str: 0",
      "stealth: false",
      "properties: []",
      "mastery: \"${8:}\"",
      "dmg1: \"\"",
      "dmg2: \"\"",
      "dmgType: \"${9:}\"",
      "range: \"\"",
      "container: false",
      "capacity: 0",
      "descr: \"${10:}\"",
      "sources:",
      "  - name: \"\"",
      "    page: 0",
      "showSources: true",
      "tags: []",
      "showTags: true",
      "```",
      "$0"
    ],
    "description": "Insert a complete MPX inline item block (all fields, with sensible empty defaults)"
  },
  "MPX Monster Block": {
    "prefix": "mpx-monster",
    "body": [
      "```monster",
      "name: \"${1:New Monster}\"",
      "slug: ${2:new-monster}",
      "attributes:",
      "  measurement: \"\"",
      "  ruleset: \"5.5e\"",
      "image: \"monsters/\"",
      "showImage: true",
      "token: \"monsters/\"",
      "showToken: true",
      "size: \"${3:}\"",
      "type: \"${4:}\"",
      "typeDetail: \"\"",
      "alignment: \"${5:}\"",
      "ac: \"${6:0}\"",
      "hp: \"${7:0}\"",
      "speed:",
      "  walk: 30",
      "  burrow: 0",
      "  climb: 0",
      "  fly: 0",
      "  hover: false",
      "  swim: 0",
      "  other: \"\"",
      "abilities: { str: 10, dex: 10, con: 10, int: 10, wis: 10, cha: 10 }",
      "savingThrows: {}",
      "skills: {}",
      "damageVulnerabilities: []",
      "damageResistances: []",
      "damageImmunities: []",
      "conditionImmunities: []",
      "senses:",
      "  blindsight: 0",
      "  darkvision: 0",
      "  tremorsense: 0",
      "  truesight: 0",
      "  other: \"\"",
      "passivePerception: 10",
      "languages: []",
      "cr: \"${8:}\"",
      "initiativeBonus: 0",
      "proficiencyBonus: 2",
      "environments: []",
      "traits:",
      "  - name: \"\"",
      "    text: \"\"",
      "actions:",
      "  - name: \"\"",
      "    text: \"\"",
      "bonusActions:",
      "  - name: \"\"",
      "    text: \"\"",
      "reactions:",
      "  - name: \"\"",
      "    text: \"\"",
      "legendaryActions:",
      "  - name: \"\"",
      "    text: \"\"",
      "descr: \"${9:}\"",
      "sources:",
      "  - name: \"\"",
      "    page: 0",
      "showSources: true",
      "tags: []",
      "showTags: true",
      "```",
      "$0"
    ],
    "description": "Insert a complete MPX inline monster block (all fields, with sensible empty defaults)"
  },
  "MPX Read-Aloud Block": {
    "prefix": "mpx-read",
    "body": [
      "> ${1:Text to read aloud.}",
      "{.read}",
      "$0"
    ],
    "description": "Insert a read-aloud text blockquote"
  },
  "MPX Large Quote": {
    "prefix": "mpx-large-quote",
    "body": [
      "> ${1:Quotation text.}",
      "{.large-quote}",
      "$0"
    ],
    "description": "Insert a large centered pull-quote blockquote"
  },
  "MPX Blockquote": {
    "prefix": "mpx-blockquote",
    "body": [
      "> **${1:Title}**",
      ">",
      "> ${2:Quotation text.}",
      "$0"
    ],
    "description": "Insert a plain Markdown blockquote"
  },
  "MPX Flowchart Step": {
    "prefix": "mpx-flowchart",
    "body": [
      "> **${2:Title}** {.text-center}",
      ">",
      "> ${3:Flowchart text.}",
      "{.${1|flowchart,flowchart-with-link|}}",
      "$0"
    ],
    "description": "Insert a flowchart step, with or without a connector"
  },
  "MPX Image": {
    "prefix": "mpx-image",
    "body": [
      "![${2:Description}](images/${3:image.png})${1| ,{.size-cover},{.float-left},{.float-right},{.center},{.caption}|}",
      "$0"
    ],
    "description": "Insert an image and choose its presentation"
  },
  "MPX Aligned Text": {
    "prefix": "mpx-text",
    "body": [
      "${2:Text.} {.${1|text-center,text-right,text-left|}}",
      "$0"
    ],
    "description": "Insert a paragraph with text alignment"
  },
  "MPX Table": {
    "prefix": "mpx-table",
    "body": [
      "| ${2:Column 1} | ${3:Column 2} |",
      "| --- | --- |",
      "| ${4:Value 1} | ${5:Value 2} |",
      "${1| ,{.blue},{.green},{.red},{.orange},{.yellow},{.gray},{.purple},{.teal},{.magenta},{.signature},{.center},{.float-left},{.float-right}|}",
      "$0"
    ],
    "description": "Insert a table with a color or presentation choice"
  },
  "MPX Roll Table": {
    "prefix": "mpx-roll-table",
    "body": [
      "${1:Roll Table Title} {.table-title}",
      "",
      "| [${2:2d6}](/roll/${2:2d6}) | ${3:Result} |",
      "|:---:|:---|",
      "| ${4:2} | ${5:Result A} |",
      "| ${6:3-4} | ${7:Result B} |",
      "$0"
    ],
    "description": "Insert a Markdown table auto-detected as a roll table at build time"
  }
}
